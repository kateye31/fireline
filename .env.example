# Copy to deploy/.env for docker compose, or export these for a local run.

# --- Hosting ---
# Your domain(s), comma-separated; Caddy gets HTTPS certificates automatically. ":80" = plain HTTP, no domain
# e.g. SITE_ADDRESS=yourdomain.com, www.yourdomain.com
SITE_ADDRESS=:80

# --- Gemma (Ollama on CPU, OpenAI-compatible) ---
# gemma3:4b reads images and runs on CPU; drop to gemma3:1b (text only) if it is too slow
GEMMA_MODEL=gemma3:4b
# GEMMA_BASE_URL is set by docker compose; for a local run point it at any OpenAI-compatible server:
# GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=EMPTY
# CPU inference is slow; the template summary shows instantly and Gemma's replaces it when ready
GEMMA_TIMEOUT_S=180
# send the smoke crop to Gemma along with the numbers
GEMMA_VISION=1

# --- Simulated satellite link ---
SAT_MAX_BYTES=340
SAT_DELAY_MIN=5
SAT_DELAY_MAX=20
SAT_DROP_RATE=0
DEMO_MODE=0

# --- Ground logic ---
OFFLINE_AFTER_S=120
INCIDENT_THRESHOLD=0.5
INCIDENT_WINDOW_S=600
