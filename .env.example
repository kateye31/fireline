# Copy to deploy/.env for docker compose, or export these for a local run.

# --- Hosting ---
# e.g. 129-212-1-2.sslip.io for automatic HTTPS
SITE_ADDRESS=:80
# Hugging Face token with access to Gemma
HF_TOKEN=

# --- Gemma (vLLM, OpenAI-compatible) ---
GEMMA_MODEL=google/gemma-3-27b-it
# GEMMA_BASE_URL is set by docker compose; for a local run point it at any OpenAI-compatible server:
# GEMMA_BASE_URL=http://localhost:8001/v1
GEMMA_API_KEY=EMPTY
# send the smoke crop to Gemma along with the numbers
GEMMA_VISION=1

# --- Simulated satellite link ---
SAT_MAX_BYTES=340
SAT_DELAY_MIN=5
SAT_DELAY_MAX=20
SAT_DROP_RATE=0
DEMO_MODE=0

# --- Ground logic ---
OFFLINE_AFTER_S=120
INCIDENT_THRESHOLD=0.5
INCIDENT_WINDOW_S=600
